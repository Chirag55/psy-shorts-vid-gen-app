{
  "expo": {
    "name": "The Mind Files Studio",
    "slug": "mindfiles-studio-mobile",
    "version": "1.8.0",
    "orientation": "portrait",
    "scheme": "mindfiles",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.mindfiles.studio",
      "versionCode": 8,
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-web-browser",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "The Mind Files Studio saves rendered videos and thumbnails to your gallery.",
          "savePhotosPermission": "The Mind Files Studio saves rendered videos and thumbnails to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Mind Files Studio imports your Veo clips from the camera roll."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraProguardRules": "-keep class com.arthenica.ffmpegkit.** { *; }"
          }
        }
      ],
      "./plugins/withFFmpegKit.js",
      "./plugins/withPrivacyHardening.js",
      "./plugins/withCrashInfo.js"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
