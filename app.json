{
  "expo": {
    "name": "The Mind Files Studio",
    "slug": "mindfiles-studio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mindfiles",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.mindfiles.studio",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-audio",
      "expo-video",
      "expo-web-browser",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "The Mind Files Studio saves rendered videos and thumbnails to your gallery.",
          "savePhotosPermission": "The Mind Files Studio saves rendered videos and thumbnails to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Mind Files Studio imports your Veo clips from the camera roll."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraProguardRules": "-keep class com.arthenica.ffmpegkit.** { *; }"
          }
        }
      ],
      "./plugins/withFFmpegKit.js"
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
